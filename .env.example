# Copy to .env and adjust. Never commit .env.
# All backend settings use the BB_ prefix.

# development | test | production
BB_ENVIRONMENT=development

# SQLite (default, zero-install) or PostgreSQL, e.g.
# BB_DATABASE_URL=postgresql+psycopg://bloodbridge:<password>@localhost:5432/bloodbridge
BB_DATABASE_URL=sqlite:///./bloodbridge.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BB_SECRET_KEY=replace-with-a-long-random-value

BB_SESSION_MINUTES=480
# Set to true when served over HTTPS
BB_COOKIE_SECURE=false
BB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave unset to expose /docs everywhere except production
# BB_EXPOSE_DOCS=false

# Operational thresholds
BB_LOW_STOCK_UNITS=10
BB_EXPIRY_WARNING_DAYS=7
BB_AVAILABILITY_FRESH_DAYS=90
BB_WHOLE_BLOOD_DEFERRAL_DAYS=90

# Used only by `python -m app.cli seed-demo` to set passwords on demo staff accounts.
# BB_DEMO_PASSWORD=
